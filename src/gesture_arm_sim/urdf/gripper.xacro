<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gripper" params="parent">
    <joint name="gripper_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="gripper_palm"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="gripper_palm">
      <visual><origin xyz="0 0 0.025"/><geometry><box size="0.05 0.12 0.05"/></geometry>
        <material name="gripper_dark"><color rgba="0.15 0.15 0.18 1"/></material></visual>
      <collision><origin xyz="0 0 0.025"/><geometry><box size="0.05 0.12 0.05"/></geometry></collision>
      <inertial><origin xyz="0 0 0.025"/><mass value="0.3"/>
        <inertia ixx="4.5e-4" iyy="1.0e-4" izz="4.5e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>

    <xacro:macro name="finger" params="name y axis_y">
      <joint name="${name}_finger_joint" type="prismatic">
        <parent link="gripper_palm"/><child link="${name}_finger"/>
        <origin xyz="0 ${y} 0.087" rpy="0 0 0"/>
        <axis xyz="0 ${axis_y} 0"/>
        <limit lower="0.0" upper="0.04" effort="40" velocity="0.1"/>
        <dynamics damping="1.0"/>
      </joint>
      <link name="${name}_finger">
        <visual><geometry><box size="0.02 0.015 0.07"/></geometry>
          <material name="finger_grey"><color rgba="0.6 0.6 0.65 1"/></material></visual>
        <collision><geometry><box size="0.02 0.015 0.07"/></geometry></collision>
        <inertial><mass value="0.05"/>
          <inertia ixx="2e-5" iyy="2e-5" izz="5e-6" ixy="0" ixz="0" iyz="0"/></inertial>
      </link>
      <gazebo reference="${name}_finger">
        <mu1>1.5</mu1><mu2>1.5</mu2>
      </gazebo>
    </xacro:macro>
    <xacro:finger name="left"  y="0.045"  axis_y="-1"/>
    <xacro:finger name="right" y="-0.045" axis_y="1"/>

    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="gripper_palm"/><child link="gripper_tcp"/>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
    </joint>
    <link name="gripper_tcp"/>

    <ros2_control name="gripper" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <joint name="left_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
